<Window x:Class="FrpcManagerCSharp.ConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FrpcManagerCSharp.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="配置编辑器 - Frpc Manager" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#f0f0f0">
    
    <Window.Resources>
        <x:Array x:Key="ProxyTypes" Type="sys:String">
            <sys:String>tcp</sys:String>
            <sys:String>udp</sys:String>
            <sys:String>http</sys:String>
            <sys:String>https</sys:String>
            <sys:String>stcp</sys:String>
            <sys:String>xtcp</sys:String>
        </x:Array>
        
        <local:BooleanToStringConverter x:Key="BooleanToStringConverter" 
                                       TrueValue="已修改" FalseValue="未修改"/>
    </Window.Resources>
    
    <Border BorderBrush="#cccccc" BorderThickness="1" CornerRadius="4" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#0078d4" CornerRadius="4,4,0,0" Padding="15,10">
                <TextBlock Text="Frpc 配置编辑器" FontSize="18" FontWeight="Bold" Foreground="White"/>
            </Border>

            <!-- 主要内容 -->
            <Grid Grid.Row="1" Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：服务器配置 -->
                <GroupBox Grid.Column="0" Header="服务器配置" Margin="0,0,5,0" Padding="10">
                    <StackPanel>
                        <TextBlock Text="服务器地址:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ServerAddr, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="5" BorderBrush="#cccccc" BorderThickness="1"/>

                        <TextBlock Text="服务器端口:" Margin="0,10,0,2" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="5" BorderBrush="#cccccc" BorderThickness="1"/>

                        <TextBlock Text="配置摘要:" Margin="0,15,0,2" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ConfigSummary}" 
                                 IsReadOnly="True" 
                                 TextWrapping="Wrap"
                                 Background="#f8f8f8"
                                 Padding="5" 
                                 BorderBrush="#cccccc" BorderThickness="1"
                                 Height="120"/>
                    </StackPanel>
                </GroupBox>

                <!-- 右侧：代理配置 -->
                <GroupBox Grid.Column="1" Header="代理配置" Margin="5,0,0,0" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 添加代理按钮 -->
                        <Button Grid.Row="0" Content="添加代理" 
                                Command="{Binding AddProxyCommand}"
                                Background="#0078d4" Foreground="White" 
                                Padding="10,5" Margin="0,0,0,10"/>

                        <!-- 代理列表 -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Proxies}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" 
                                  BorderBrush="#cccccc" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="80"/>
                                <DataGridComboBoxColumn Header="类型" SelectedItemBinding="{Binding Type}" Width="60">
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource" Value="{Binding Source={StaticResource ProxyTypes}}"/>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>
                                <DataGridTextColumn Header="本地IP" Binding="{Binding LocalIP}" Width="90"/>
                                <DataGridTextColumn Header="本地端口" Binding="{Binding LocalPort}" Width="70"/>
                                <DataGridTextColumn Header="远程端口" Binding="{Binding RemotePort}" Width="70"/>
                                <DataGridTemplateColumn Header="操作" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="删除" 
                                                    Command="{Binding DataContext.RemoveProxyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#dc3545" Foreground="White" 
                                                    Padding="5,2" FontSize="10"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>
            </Grid>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="15,10">
                <TextBlock Text="{Binding IsModified, Converter={StaticResource BooleanToStringConverter}}" 
                           VerticalAlignment="Center" Margin="0,0,20,0" 
                           Foreground="#dc3545" FontWeight="SemiBold"/>
                
                <Button Content="调试代理" 
                        Command="{Binding DebugProxiesCommand}"
                        Background="#ffc107" Foreground="Black" 
                        Padding="15,8" Margin="0,0,10,0" FontWeight="SemiBold"/>
                
                <Button Content="保存" 
                        Command="{Binding SaveConfigCommand}"
                        Background="#28a745" Foreground="White" 
                        Padding="20,8" Margin="0,0,10,0" FontWeight="SemiBold"/>
                
                <Button Content="取消" 
                        IsCancel="True"
                        Background="#6c757d" Foreground="White" 
                        Padding="20,8"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>