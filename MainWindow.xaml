<Window x:Class="FrpcManagerCSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FrpcManagerCSharp"
        mc:Ignorable="d"
        Title="Frpc管理器" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="Frpc客户端管理器" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- 控制按钮区域 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" 
                   HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button Content="启动" Width="80" Height="35" Margin="5"
                    Command="{Binding StartCommand}"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"/>
            
            <Button Content="停止" Width="80" Height="35" Margin="5"
                    Command="{Binding StopCommand}"
                    IsEnabled="{Binding IsRunning}"/>
            
            <Button Content="重启" Width="80" Height="35" Margin="5"
                    Command="{Binding RestartCommand}"/>
            
            <Button Content="编辑配置" Width="90" Height="35" Margin="5"
                    Command="{Binding EditConfigCommand}"
                    Background="#0078d4" Foreground="White"
                    Padding="15,8" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- 状态显示 -->
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" 
                CornerRadius="5" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 状态栏 -->
                <Border Grid.Row="0" Background="LightGray" CornerRadius="5,5,0,0">
                    <StackPanel Orientation="Horizontal" Margin="10,5">
                        <TextBlock Text="状态: " FontWeight="Bold"/>
                        <TextBlock Text="{Binding Status}" 
                                  Foreground="{Binding Status, Converter={StaticResource StatusColorConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- 日志显示 -->
                <ScrollViewer Grid.Row="1" Margin="10">
                    <TextBox Text="{Binding Logs, Converter={StaticResource ObservableCollectionToStringConverter}}"
                             IsReadOnly="True"
                             Background="White"
                             FontFamily="Consolas"
                             FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 底部信息 -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="Frpc客户端管理器 v1.0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding DateTime.Now, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
