<Window x:Class="FrpcManagerCSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FrpcManagerCSharp"
        xmlns:converters="clr-namespace:FrpcManagerCSharp.Converters"
        mc:Ignorable="d"
        Title="Frpc管理器" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#f0f2f5">
    
    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:StatusColorConverter x:Key="StatusColorConverter"/>
        <DropShadowEffect x:Key="DropShadowEffect" ShadowDepth="2" BlurRadius="3" Opacity="0.2" Direction="315"/>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                                <Setter Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource Self}, Path=Background}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="1" Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="Frpc客户端管理器" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,10,0,20"
                   Foreground="#333333"/>

        <!-- 配置文件管理区域 -->
        <Border Grid.Row="1" BorderBrush="#e0e0e0" BorderThickness="1" 
                CornerRadius="6" Margin="0,0,0,15" Background="White" 
                Effect="{StaticResource DropShadowEffect}">
            <StackPanel Orientation="Horizontal" Margin="15" VerticalAlignment="Center">
                <TextBlock Text="配置文件:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" 
                           Foreground="#333333"/>
                <ComboBox ItemsSource="{Binding ConfigNames}" 
                          SelectedItem="{Binding SelectedConfig}"
                          Width="200" Height="35" Margin="0,0,15,0"
                          VerticalContentAlignment="Center" Background="#f8f9fa" BorderBrush="#ddd"/>
                <Button Content="新建" Width="65" Height="35"
                        Command="{Binding CreateConfigCommand}"
                        Background="#28a745" Foreground="White" FontWeight="Medium"/>
                <Button Content="编辑" Width="90" Height="35"
                        Command="{Binding EditConfigCommand}"
                        Background="#0078d4" Foreground="White" FontWeight="Medium"/>
                <Button Content="重命名" Width="65" Height="35"
                        Command="{Binding RenameConfigCommand}"
                        Background="#ffc107" Foreground="Black" FontWeight="Medium"/>
                <Button Content="删除" Width="65" Height="35"
                        Command="{Binding DeleteConfigCommand}"
                        Background="#dc3545" Foreground="White" FontWeight="Medium"/>
            </StackPanel>
        </Border>

        <!-- 配置摘要显示 -->
        <Border Grid.Row="2" BorderBrush="#e0e0e0" BorderThickness="1" 
                CornerRadius="6" Margin="0,0,0,15" Background="White"
                Effect="{StaticResource DropShadowEffect}">
            <TextBlock Text="{Binding ConfigSummary}" 
                       Margin="15" FontFamily="Consolas" FontSize="12" 
                       Foreground="#444444"/>
        </Border>

        <!-- 控制按钮区域 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" 
                   HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button Content="启动" Width="90" Height="40"
                    Command="{Binding StartCommand}"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                    Background="#17a2b8" Foreground="White" FontWeight="Medium"/>
            
            <Button Content="停止" Width="90" Height="40"
                    Command="{Binding StopCommand}"
                    IsEnabled="{Binding IsRunning}"
                    Background="#6c757d" Foreground="White" FontWeight="Medium"/>
            
            <Button Content="重启" Width="90" Height="40"
                    Command="{Binding RestartCommand}"
                    Background="#6f42c1" Foreground="White" FontWeight="Medium"/>
        </StackPanel>

        <!-- 状态显示 -->
        <Border Grid.Row="4" BorderBrush="#e0e0e0" BorderThickness="1" 
                CornerRadius="6" Margin="0,0,0,15" Background="White"
                Effect="{StaticResource DropShadowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 状态栏 -->
                <Border Grid.Row="0" Background="#f8f9fa" CornerRadius="6,6,0,0" Padding="15,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="状态: " FontWeight="Bold" Foreground="#333333"/>
                        <TextBlock Text="{Binding Status}" 
                                  Foreground="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                  FontWeight="Medium"/>
                    </StackPanel>
                </Border>

                <!-- 日志显示 -->
                <ScrollViewer x:Name="LogScrollViewer" Grid.Row="1" Margin="15" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LogsItemsControl" ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" 
                                           FontFamily="Consolas" 
                                           FontSize="12" 
                                           TextWrapping="Wrap" 
                                           Margin="0,2" 
                                           Padding="5" 
                                           Background="#f8f9fa" 
                                           Foreground="#333333"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 底部信息 -->
        <StatusBar Grid.Row="5" Background="#f8f9fa" BorderThickness="1,1,0,0" BorderBrush="#e0e0e0">
            <StatusBarItem>
                <TextBlock Text="Frpc客户端管理器 v1.0" Foreground="#666666"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding DateTime.Now, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Foreground="#666666"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
